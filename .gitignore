```gitignore
# Pipeline outputs: ignore all files by default, keep directory tree traversable
output/**
!output/**/
!output/README.md
!output/**/*.csv
!output/**/*.png
!output/**/*.pdf

# Large astronomical data
*.fits
*.fit
*.fts
*.fits.gz
*.fit.gz
*.fts.gz
*.fits.part
*.part
*.fz
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle

# Local configuration and secrets
config.json
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
spx_env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Jupyter
.ipython/
profile_default/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.code-workspace

# Cache and coverage
.cache/
.pyre/
.coverage
htmlcov/
```